# This file contains tests for commands from the eventlog.tcl

package require tcltest
eval tcltest::configure $argv

source [file join [file dirname [info script]] testutil.tcl]
load_twapi_package twapi_evt
load_twapi_package twapi_process; # Needed for proc privileged

tcltest::testConstraint haveFrenchLocale [file exists {C:\Windows\System32\fr-FR\wevtsvc.dll.mui}]

namespace eval twapi::evt::test {
    namespace import ::tcltest::test
    namespace import ::tcl::mathop::== ::tcl::mathop::eq
    variable testnum
    variable source
    variable type

    proc privileged {} {
        if {[twapi::min_os_version 6]} {
            if {[twapi::process_in_administrators] &&
                [twapi::get_process_elevation] eq "full"} {
                return 1
            } else {
                return 0
            }
        } else {
            return [twapi::process_in_administrators]
        }
    }
    ::tcltest::testConstraint privileged [privileged]

    proc new_file {{ext evtx}} {
        variable file_name_ctr
        return [file join [tcltest::temporaryDirectory] evttest-[incr file_name_ctr].$ext]
    }

    # Get credentials for EVT sessions
    proc evt_test_creds {target} {
        variable evt_test_creds
        if {![info exists evt_test_creds] || ![dict exists $evt_test_creds $target]} {
            dict set evt_test_creds $target [twapi::cred_prompt_gui $target]
        }
        return [dict get $evt_test_creds $target]
    }

    # Returns a remote session object used for tests
    proc remote_session {} {
        lassign [evt_test_creds $::env(COMPUTERNAME)] user pw save
        return [EvtSession new -user $user -password $pw]
    }

    # Returns path to the exported Setup log file
    variable exported_setup_event_file
    proc exported_setup_events_file {} {
        variable exported_setup_event_file
        if {![info exists exported_setup_event_file] ||
            ![file exists $exported_setup_event_file]
        } {
            set exported_setup_event_file [new_file exported_setup_events.evt]
            set sess [twapi::EvtSession new]
            $sess exportEvents $exported_setup_event_file -channel Setup
        }
        return $exported_setup_event_file
    }

    proc verify_event {e {expected {}}} {
        set messages {}
        foreach fld {
            -channel -taskname -message -providername -eventid -level -levelname -eventrecordid -computer -sid -timecreated
        } {
            if {![dict exists $e $fld]} {
                lappend messages "Field $fld missing from event"
            }
            if {[dict exists $expected $fld] &&
                [dict get $expected $fld] != [dict get $e $fld]
            } {
                lappend message "Field value for $fld ([dict get $e $fld]) does not match expected value ([dict get $expected $fld])"
            }
        }
        return $messages
    }

    proc event_count {osess args} {
        return [sess with [list newLogInfo {*}$args] recordCount]
    }

    proc verify_channel_config {osess channel} {
        set ocfg [$osess newChannelConfig $channel]
        set errors ""
        try {
            foreach meth {
                isEnabled isClassic hasAutoBackup retention
            } {
               set value [$ocfg $meth]
               if {![string is boolean -strict $value]} {
                   lappend errors "$channel method \"$meth\" returned non-boolean value \"$value\""
               }
            }
            foreach meth {
                bufferSize isolation minBuffers maxBuffers maxFiles maxSize
                latency type
            } {
               set value [$ocfg $meth]
               if {![string is integer -strict $value]} {
                   lappend errors "$channel method \"$meth\" returned non-integer value \"$value\""
               }
               if {$value < 0} {
                   lappend errors "$channel method \"$meth\" returned negative value \"$value\""
               }
            }
            foreach meth {levelFilter keywordFilter} {
                set value [$ocfg $meth]
                # Note empty strings are ok
                if {![string is integer $value]} {
                    lappend errors "$channel method \"$meth\" returned non-integer value \"$value\""
                }
                if {$value ne "" && $value < 0} {
                    lappend errors "$channel method \"$meth\" returned negative value \"$value\""
                }
            }
            foreach {meth upper} {
                isolation 2 type 3 sidType 1 clockType 1
            } {
                set value [$ocfg $meth]
                if {$value < 0 || $value > $upper} {
                    lappend errors "$channel method \"$meth\" returned unexpected value \"$value\""
                }
            }
            set value [$ocfg access]
            if {[catch {twapi::sddl_to_security_descriptor $value} secd]} {
                lappend errors "$channel method \"access\" returned unexpected value \"$value\""
            }

            set value [$ocfg controlGuid]
            if {$value ne "" && ![twapi::Twapi_IsValidGUID $value]} {
                lappend errors "$channel method \"controlGuid\" returned unexpected value \"$value\""
            }
            set value [$ocfg name]; # Just ensure no error
            if {![string equal $value $channel]} {
                lappend errors "$channel method \"name\" returned unexpected value \"$value\""
            }
            set pub [$ocfg publisher]; # Just ensure no error, can be empty
            if {[llength [$ocfg publishers]] == 0 && $pub ne ""} {
                # publishers should include at least the owning publisher
                lappend errors "$channel method \"publishers\" returned 0 publishers"
            }
            set value [$ocfg filePath]
            if {![file exists [twapi::expand_environment_vars $value]]} {
                # File may not exist, verify plausible name
                set basename [file rootname [file tail $value]]
                if {![string equal $basename [string map {/ %4} $channel]]} {
                    lappend errors "$channel method \"filePath\" returned non-existent path \"$value\""
                }
            }
        } finally {
            $ocfg destroy
        }
        return [join $errors \n]
    }
    proc natural {n} {
        expr {[string is integer -strict $n] && $n >= 0}
    }
    proc integer {n} {
        string is integer -strict $n
    }

    proc verify_publisher_channels {osess publisher op} {
        set errors {}
        foreach chan_dict [$op channels] {
            array set chan $chan_dict
            set imported $chan(-channelflags)
            if {$imported ni {0 1}} {
                lappend errors "$publisher invalid -channelflags value \"$imported\""
            }
            if {![string is integer -strict $chan(-channelindex)] ||
                $chan(-channelindex) < -1} {
                lappend errors "$publisher invalid -channelindex value \"$chan(-channelindex)\""
            }
            if {![natural $chan(-channelid)]} {
                lappend errors "$publisher invalid -channelid value \"$chan(-channelid)\""
            }
            set chan_path [dict get $chan_dict -channelpath]
            if {[lsearch -nocase -ascii [wevtutil_channels] $chan_path] < 0
                || $chan_path eq "Security"} {
                continue
            }
            set ocfg [$osess newChannelConfig $chan_path]
            try {
                set chan_publisher [$ocfg publisher]
                if {[lsearch -nocase [$ocfg publishers] $publisher] < 0} {
                    lappend errors "$publisher - not present in $chan_path publishers \"[$ocfg publishers]\""
                }
                if {!$imported &&
                    ![string equal -nocase $publisher [$ocfg publisher]]} {
                    lappend errors "$publisher - mismatch in owner channel. \"$publisher\" versus [$ocfg publisher]"
                }
            } finally {
                $ocfg destroy
            }
        }
        return $errors
    }
    proc verify_publisher_events {osess publisher op} {
        set errors {}
        set props {-channel -eventid -keywords -level -messageid -opcode -task -template -version}
        foreach ev_dict [$op events $props] {
            array set ev $ev_dict
            foreach prop {-channel -eventid -keywords -level -messageid -opcode -task -version} {
                if {![natural $ev($prop)]} {
                    lappend errors "$publisher - event $ev(-eventid) $prop value $ev($prop) is not a natural integer."
                    break
                }
            }
            # Some templates have broken syntax (like no terminating /template)
            # so a loose check
            if {$ev(-template) ne "" &&
                ![regexp {^<template.*} $ev(-template)]
            } {
                lappend errors "$publisher - event $ev(-eventid) -template value $ev(-template) does not match template syntax."
                break
            }
        }
        return $errors
    }
    proc verify_publisher_dictionaries {osess publisher op values_meth labels_meth} {
        set errors {}
        set labels [$op $labels_meth]
        foreach value_dict [$op $values_meth] {
            set value [dict get $value_dict -value]
            if {![dict exists $value_dict -name] ||
                ![natural $value] ||
                ![integer [dict get $value_dict -messageid]]
            } {
                lappend errors "$publisher method \"$values_meth\" returned list with invalid dictionary \"$value_dict\""
                continue
            }
            if {$values_meth eq "opcodes"} {
                if {![dict exists $value_dict -task] ||
                    ![natural [dict get $value_dict -task]]} {
                    lappend errors "$publisher method \"$values_meth\" returned \"$value_dict\" with missing or invalid -task key"
                }
            }
            if {![dict exists $labels $value]} {
                lappend errors "$publisher method \"$labels_meth\" returned dictionary \"$labels\" with key \"$value\" missing."
            }
        }
        return $errors
    }

    proc verify_publisher {osess publisher} {
        puts $publisher
        set errors ""
        set op [$osess newPublisher $publisher]
        try {
            set value [$op name]
            if {![string equal -nocase $publisher $value]} {
                lappend errors "$publisher method \"name\" returned \"$value\""
            }
            lappend errors {*}[verify_publisher_channels $osess $publisher $op]
            lappend errors {*}[verify_publisher_events $osess $publisher $op]
            set value [$op guid]
            if {![twapi::Twapi_IsValidGUID $value]} {
                lappend errors "$publisher method \"guid\" returned unexpected value \"$value\""
            }
            set value [$op handle]
            if {![natural [lindex $value 0]] || [lindex $value 1] ne "EVT_HANDLE"} {
                lappend errors "$publisher method \"handle\" returned unexpected value \"$value\""
            }
            set value [$op helpLink]
            if {$value ne "" && ![string match https:* $value]} {
                lappend errors "$publisher method \"helpLink\" returned unexpected value \"$value\""
            }
            set value [$op lcid]
            if {![natural $value]} {
                lappend errors "$publisher method \"lcid\" returned unexpected value \"$value\""
            }
            lappend errors {*}[verify_publisher_dictionaries $osess $publisher $op \
                                   keywords keywordLabels]
            lappend errors {*}[verify_publisher_dictionaries $osess $publisher $op \
                                   levels levelLabels]
            lappend errors {*}[verify_publisher_dictionaries $osess $publisher $op \
                                   opcodes opcodeLabels]
            lappend errors {*}[verify_publisher_dictionaries $osess $publisher $op \
                                   tasks taskLabels]
            foreach meth {messageFile resourceFile parameterFile} {
                # No validation other than ensure no error raised
                # The file path may or may not exist
                $op $meth
            }

            set value [$op messageId]
            if {![integer $value] || $value < -1} {
                lappend errors "$publisher method \"messageId\" returned unexpected value \"$value\""
            }
            if {$value != -1} {
                # Just verify does not raise error
                $op message $value
            }
        } finally {
            $op destroy
        }
        return [join $errors \n]
    }

    proc verify_log_info {osess channel} {
        set oli [$osess newLogInfo -channel $channel]
        set errors ""
        try {
            foreach meth {creationTime lastAccessTime lastWriteTime} {
                set value [$oli $meth]
                if {![string is integer $value]} {
                    lappend errors "$channel method \"$meth\" returned non-integer value \"$value\""
                }
                if {$value eq ""} {
                    continue
                }
                set secs [twapi::large_system_time_to_secs_since_1970 $value]
                # Expect timestamps between years 2000 and 2050
                if {$secs < 946665000 || $secs > 2524588200} {
                    lappend errors "$channel method \"$meth\" returned suspicious clock value \"$value\""
                }
            }
            foreach meth {fileSize attributes recordCount oldestRecordNumber} {
               set value [$oli $meth]
               if {![string is integer $value]} {
                   lappend errors "$channel method \"$meth\" returned non-integer value \"$value\""
               }
               if {$value ne "" && $value < 0} {
                   lappend errors "$channel method \"$meth\" returned negative value \"$value\""
               }
            }
            set value [$oli isFull]
            if {![string is boolean $value]} {
                lappend errors "$channel method \"isFull\" returned non-boolean value \"$value\""
            }
            set value [$oli logType]
            if {$value ne "channel"} {
                lappend errors "$channel method \"logType\" returned \"$value\""
            }
            set value [$oli logName]
            if {![string equal -nocase $value $channel]} {
                lappend errors "$channel method \"name\" returned \"$value\""
            }
        } finally {
            $oli destroy
        }
        return [join $errors \n]
    }

    ###

    test EvtSession-1.0 {create local session} -body {
        list [twapi::EvtSession create lsess] \
            [lsess isLocal] [lsess destroy] \
            [info class instances ::twapi::EvtSession]
    } -result [list [namespace current]::lsess 1 {} {}]

    test EvtSession-1.1 {new local session with unique names} -body {
        set o [twapi::EvtSession new]
        set o2 [twapi::EvtSession new]
        list [expr {$o ne $o2}] \
            [$o isLocal] [$o destroy] \
            [$o2 isLocal] [$o2 destroy] \
            [info class instances ::twapi::EvtSession]
    } -result [list 1 1 {} 1 {} {}]

    test EvtSession-2.0 {
        create remote session
    } -constraints userInteraction -body {
        lassign [evt_test_creds $::env(COMPUTERNAME)] user pw save
        list [twapi::EvtSession create rsess -system $::env(COMPUTERNAME) \
                  -user $user -password $pw] \
            [rsess isLocal] [rsess destroy] \
            [info class instances ::twapi::EvtSession]
    } -result [list [namespace current]::rsess 0 {} {}]

    test EvtSession-2.1 {
        create remote session using current credentials
    } -body {
        list [twapi::EvtSession create rsess -system ""] \
            [rsess isLocal] [rsess destroy] \
            [info class instances ::twapi::EvtSession]
    } -result [list [namespace current]::rsess 0 {} {}]

    test EvtSession-2.2 {
        create remote session with bogus user
    } -constraints userInteraction -body {
        lassign [evt_test_creds $::env(COMPUTERNAME)] user pw save
        list [catch {
            twapi::EvtSession create rsess -system $::env(COMPUTERNAME) \
                -user x$user -password $pw
            # Above will not fail until accessed
            rsess newPublisher Microsoft-Windows-Eventlog
        } msg] $msg [rsess isLocal] [rsess destroy] \
            [info class instances ::twapi::EvtSession] \
            [info class instances ::twapi::EvtPublisher]
    } -result {1 {Access is denied.} 0 {} {} {}}

    test EvtSession-2.3 {
        create remote session with bogus user
    } -constraints userInteraction -body {
        lassign [evt_test_creds $::env(COMPUTERNAME)] user pw save
        list [catch {
            twapi::EvtSession create rsess -system $::env(COMPUTERNAME) \
                -user $user -password [twapi::conceal bogus]
            # Above will not fail until accessed
            rsess newPublisher Microsoft-Windows-Eventlog
        } msg] $msg [rsess isLocal] [rsess destroy] \
            [info class instances ::twapi::EvtSession] \
            [info class instances ::twapi::EvtPublisher]
    } -result {1 {Access is denied.} 0 {} {} {}}

    test EvtSession-3.0 {
        create remote session -domain
    } -constraints userInteraction -body {
        lassign [evt_test_creds $::env(COMPUTERNAME)] user pw save
        list [twapi::EvtSession create rsess -system $::env(COMPUTERNAME) \
                  -user $user -password $pw -domain $::env(COMPUTERNAME)] \
            [rsess isLocal] [rsess destroy] \
            [info class instances ::twapi::EvtSession]
    } -result [list [namespace current]::rsess 0 {} {}]

    test EvtSession-channels-1.0 {
        EvtSession channels
    } -setup {
        twapi::EvtSession create sess
        set expected [wevtutil_channels]
    } -cleanup {
        sess destroy
    } -body {
        string equal -nocase $expected [lsort -nocase [sess registeredChannels]]
    } -result 1

    test EvtSession-publishers-1.0 {
        EvtSession publishers
    } -setup {
        twapi::EvtSession create sess
        set expected [lsort -nocase [split [wevtutil ep] \n]]
    } -cleanup {
        sess destroy
    } -body {
        set pubs [lsort -nocase [sess publishers]]
        string equal -nocase $expected $pubs
    } -result 1

