    ###

    test EvtSession-exportEvents-1.0 {
        EvtSession exportEvents -channel and -logfile
    } -setup {
        twapi::EvtSession create sess
        set backup [new_file]
        set backup2 [new_file]
        set count [event_count sess -channel Setup]
    } -cleanup {
        sess destroy
        file delete $backup
        file delete $backup2
    } -body {
        sess exportEvents $backup -channel Setup
        sess exportEvents $backup2 -logfile $backup
        list \
            [expr {$count == [event_count sess -logfile $backup]}] \
            [expr {$count == [event_count sess -logfile $backup2]}]
    } -result {1 1}

    test EvtSession-exportEvents-2.0 {
        EvtSession exportEvents -query XPATH query
    } -setup {
        twapi::EvtSession create sess
        set backup [new_file]
        set count [event_count sess -channel Setup]
    } -cleanup {
        sess destroy
        file delete $backup
    } -body {
        sess exportEvents $backup -channel Setup \
            -query {*[System[EventID=1]]}
        set exported_count [event_count sess -logfile $backup]
        expr {$count > $exported_count}
    } -result 1

    test EvtSession-exportEvents-2.1 {
        EvtSession exportEvents -query structured XML query
    } -setup {
        twapi::EvtSession create sess
        set backup [new_file]
        set count [event_count sess -channel Setup]
    } -cleanup {
        sess destroy
        file delete $backup
    } -body {
        sess exportEvents $backup -channel Setup \
            -query {
                <QueryList>
                <Query Id="0" Path="Setup">
                <Select Path="Setup">*[System[EventID!=1]]</Select>
                </Query>
                </QueryList> }
        set exported_count [event_count sess -logfile $backup]
        expr {$count > $exported_count}
    } -result 1

    ###

    test EvtSession-archiveLogFile-1.0 {
        EvtSession archiveLogFile
    } -constraints privileged -setup {
        twapi::EvtSession create sess
        set archive [new_file]
        sess exportEvents $archive -channel Setup
        set count [event_count sess -logfile $archive]
        set size [file size $archive]
    } -cleanup {
        sess destroy
        file delete $archive
        file delete -force $mta_dir
    } -body {
        sess archiveLogFile $archive
        sess archiveLogFile $archive -lcid 1036
        set archived_count [event_count sess -logfile $archive]
        set mta_dir [file join [file dirname $archive] LocaleMetaData]
        # The "0" is for thread default locale
        set mta0 [file join $mta_dir [file rootname [file tail $archive]]_0.MTA]
        set mta1036 [file join $mta_dir [file rootname [file tail $archive]]_1036.MTA]
        list \
            [expr {$archived_count == $count}] \
            [file exists $mta0] \
            [file exists $mta1036]
    } -result {1 1 1}

