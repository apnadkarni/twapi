        lsort -index 0 [$or info]
    } -result {{Microsoft-Windows-WindowsUpdateClient/Operational 0} {NoSuchChannel 15007}}

    evttest EvtReader-seek-1.0 {Seek -origin} {
        set hevs {}
        try {
            set result {}
            lassign [sess with newReader {
                getEvents -count 3
            }] first second third
            lappend hevs $first $second $third
            set first_record_id [event_record_id $first]
            set second_record_id [event_record_id $second]
            set third_record_id [event_record_id $third]
            lassign [sess with {newReader -direction backward} {
                getEvents -count 2
            }] last penultimate
            lappend hevs $last $penultimate
            set last_record_id [event_record_id $last]
            set penultimate_record_id [event_record_id $penultimate]
            set or [sess newReader]

            $or seek 1; # Default origin (current)
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $second_record_id}]

            $or seek -1 -origin current; # origin current, negative offset
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $second_record_id}]

            $or seek 0 -origin last; # origin last, zero offset
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $last_record_id}]

            $or seek 0 -origin first; # origin first, zero offset
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $first_record_id}]

            $or seek -1 -origin last; # origin last, negative offset
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $penultimate_record_id}]

            $or seek 1 -origin first; # origin first, positive offset
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $second_record_id}]

        } finally {
            twapi::evt_close {*}$hevs
        }
    } -result {1 1 1 1 1 1}

    evttest EvtReader-seek-2.0 {Seek -strict } {
        set hevs {}
        try {
            set result {}
            lassign [sess with newReader {
                getEvents -count 2
            }] first second
            lappend hevs $first $second
            set first_record_id [event_record_id $first]
            set second_record_id [event_record_id $second]
            set or [sess newReader]
            $or seek 1; # Default origin (current)
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $second_record_id}]
            $or seek -3; # Seek before first
            lassign [$or getEvents -count 1] hev
            lappend hevs $hev
            lappend result [expr {[event_record_id $hev] == $first_record_id}]

            lappend result [catch {$or seek -3 -strict}] [lrange $::errorCode 0 1]
        } finally {
            twapi::evt_close {*}$hevs
        }
    } -result {1 1 1 {TWAPI_WIN32 1168}}

    evttest EvtReader-seek-3.0 {Seek invalid offsets} {
        set or [sess newReader]
        list [catch {$or seek notanint} message] $message
    } -result {1 {expected integer but got "notanint"}}

    evttest EvtReader-seek-3.1 {Seek invalid offsets} {
        set or [sess newReader]
        list [catch {$or seek {}} message] $message
    } -result {1 {expected integer but got ""}}

    ### EvtFormatter
    # Most EvtFormatter functionality is tested as part of EvtReader. Tests below
    # exercise a few other bits like localization.

    evttest EvtFormatter-logarchive-1.0 {
        EvtFormatter -logarchive
    } {
        set of [sess newFormatter -logarchive [archived_setup_event_file]]
        set or [sess newReader -logfile [archived_setup_event_file]]
        # Just check no error raised since there is not sure how to check
        # archive data is used and not the system metadata
        set hevs [$or getEvents -count 3]
        try {
            twapi::recordarray size [$of decodeEvents $hevs]
        } finally {
            twapi::evt_close {*}$hevs
        }
    } -result 3 -constraints privileged

    evttest EvtFormatter-format-1.0 {
        EvtFormatter formatEvent and formatEventAsXml
    } {
        set of [sess newFormatter]
        set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=26]]}]
        lassign [$or getEvents -count 1] hev
        try {
            set message [$of formatEvent $hev]
            set xml [$of formatEventAsXml $hev]
            puts $xml
            list [string match "Windows Update*" $message] \
                [string equal [dict get [$of decodeEvent $hev -message] -message] $message] \
                [string match {<Event*<System>*</System>*<Message>Windows Update*</Event>} $xml]
        } finally {
            twapi::evt_close $hev
        }
    } -result {1 1 1}

    evttest EvtFormatter-decode-event-1.0 {
        EvtFormatter decodeEvent - default properties
    } {
        set of [sess newFormatter]
        set or [sess newReader]
        lassign [$or getEvents -count 1] hev
        try {
            lsort [dict keys [$of decodeEvent $hev]]
        } finally {
            twapi::evt_close $hev
        }
    } -result {-eventid -level -message -providername -timecreated}

    evttest EvtFormatter-decode-events-1.0 {
        EvtFormatter decodeEvents - default properties
    } {
        set of [sess newFormatter]
        set or [sess newReader]
        set hevs [$or getEvents -count 2]
        try {
            lsort [twapi::recordarray fields [$of decodeEvents $hevs]]
        } finally {
            twapi::evt_close {*}$hevs
        }
    } -result {-eventid -level -message -providername -timecreated}

    evttest EvtFormatter-fr-1.0 {
        EvtFormatter decode -lcid
    } {
        set of [sess newFormatter -lcid 1036]
        set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=31]]}]
        set opcode Télécharger
        set task "Agent de mise à jour automatique Windows Update"
        set level Erreur
        set keyword Échec
        set message {Échec du téléchargement*}

        set hevs [$or getEvents -count 1]
        if {[llength $hevs] == 0} {
            $or destroy
            set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=25]]}]
            set opcode {Rechercher les mises à jour}
            set level Erreur
            set message {L’erreur * s’est produite*}
            set hevs [$or getEvents -count 1]
        }
        if {[llength $hevs] == 0} {
            $or destroy
            set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=26]]}]
            set opcode {Rechercher les mises à jour}
            set level Information
            set keyword Succès
            set message {Windows Update a trouvé*}
            set hevs [$or getEvents -count 1]
        }
        if {[llength $hevs] == 0} {
            error "Could not find suitable event in channel"
        }
        try {
            lassign $hevs hev
            array set decoded [$of decodeEvent $hev {-level -opcode -task -keywords -message}]
            list \
                [expr {$decoded(-opcode) eq $opcode}] \
                [expr {$decoded(-level) eq $level}] \
                [expr {$decoded(-task) eq $task}] \
                [expr {$keyword in $decoded(-keywords)}] \
                [string match $message $decoded(-message)] \
                [string match $message [$of formatEvent $hev]]
        } finally {
            twapi::evt_close $hev
        }
    } -result {1 1 1 1 1 1} -constraints haveFrenchLocale

    # Known bug - should try 1033 locale on failure and at least return
    # numeric value for level etc.
    evttest EvtFormatter-fr-2.0 {
        EvtFormatter decode -lcid for non-existing LCID
    } {
        set of1033 [sess newFormatter -lcid 1033]
        set of [sess newFormatter -lcid 1037]
        set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=31]]}]
        set hevs [$or getEvents -count 1]
        if {[llength $hevs] == 0} {
            $or destroy
            set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=25]]}]
        }
        if {[llength $hevs] == 0} {
            $or destroy
            set or [sess newReader -channel Microsoft-Windows-WindowsUpdateClient/Operational -query {*[System[EventID=26]]}]
        }
        if {[llength $hevs] == 0} {
            error "Could not find suitable event in channel"
        }
        try {
            lassign $hevs hev
            array set dec1033 [$of1033 decodeEvent $hev {-level -opcode -task -keywords -message}]
            array set decoded [$of decodeEvent $hev {-level -opcode -task -keywords -message}]
            list \
                [expr {$decoded(-opcode) eq $dec1033(-opcode)}] \
                [expr {$decoded(-level) eq $dec1033(-level)}] \
                [expr {$decoded(-task) eq $dec1033(-task)}] \
                [expr {$decoded(-keywords) eq $dec1033(-keywords)}] \
                [expr {$decoded(-message) eq $dec1033(-message)}]
        } finally {
            twapi::evt_close $hev
        }
    } -result {1 1 1 1 1} -constraints {haveFrenchLocale knownBug}

    ### Bookmarks

    evttest evt-bookmarks-1.0 {
        evt_bookmark_create, evt_bookmark_update, evt_seek -bookmark
    } {
        set or [sess newReader -channel Setup]
        set hevs [$or getEvents -count 2]
        try {
            set hev [lindex $hevs 1]
            set xml [twapi::evt_event_xml $hev]
            set hbm [twapi::evt_bookmark_create]
            twapi::evt_bookmark_update $hbm $hev
            lappend hevs {*}[$or getEvents -count 2]
            # This next just to ensure cursor moved
            set xml2 [twapi::evt_event_xml [lindex $hevs end]]
            $or seek 0 -hbookmark $hbm
            lappend hevs {*}[$or getEvents -count 1]
            set xml3 [twapi::evt_event_xml [lindex $hevs end]]
            list [string equal $xml $xml2] [string equal $xml $xml3]
        } finally {
            twapi::evt_close {*}$hevs
            if {[info exists hbm]} {
                twapi::evt_close $hbm
            }
        }
    } -result {0 1}

    evttest evt-bookmarks-2.0 {
        evt_bookmark_render
    } {
        set or [sess newReader -channel Setup]
        set hevs [$or getEvents -count 2]
        try {
            set hev [lindex $hevs 1]
            set xml [twapi::evt_event_xml $hev]
            set hbm [twapi::evt_bookmark_create]
            twapi::evt_bookmark_update $hbm $hev
            set xmlbm [twapi::evt_bookmark_render $hbm]
        } finally {
            twapi::evt_close {*}$hevs
            if {[info exists hbm]} {
                twapi::evt_close $hbm
                unset hbm
            }
        }
        set hevs {}
        $or destroy
        set or [sess newReader -channel Setup]
        try {
            set hbm [twapi::evt_bookmark_create $xmlbm]
            $or seek 0 -hbookmark $hbm
            set hevs [$or getEvents -count 1]
            set xml2 [twapi::evt_event_xml [lindex $hevs 0]]
            string equal $xml $xml2
        } finally {
            twapi::evt_close {*}$hevs
            if {[info exists hbm]} {
                twapi::evt_close $hbm
            }
        }
    } -result 1

    ### evt_event_*

    test evt_event_logpath-1.0 {
        Get the channel or file containing the event
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        twapi::evt_event_logpath $hev
    } -result Setup

    test evt_event_xml-1.0 {
        Render event XML
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        twapi::evt_event_xml $hev
    } -result {<Event*<System>*</System>*</Event>} -match glob

    ### evt_render_*

    test evt_render_context_system-1.0 {
        Render context for system properties
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        set hctx [twapi::evt_render_context_system]
        set xml [twapi::evt_event_xml $hev]
        regexp {Provider Name='([^']+)'\s+Guid='([^']+)'.+ProcessID='([^']+)'} $xml -> provider guid pid
        set values [twapi::evt_event_render $hev $hctx]
        twapi::evt_close $hctx
        list [llength $values] \
            [expr {$provider eq [lindex $values 0]}] \
            [string equal -nocase $guid [lindex $values 1]] \
            [expr {$pid eq [lindex $values 12]}] \
            [lindex $values 14]
    } -result [list 18 1 1 1 Setup]

    test evt_render_context_userdata-1.0 {
        Render context for userdata properties
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        set hctx [twapi::evt_render_context_userdata]
        set values [twapi::evt_event_render $hev $hctx]
        twapi::evt_close $hctx
        set xml [twapi::evt_event_xml $hev]
        regexp {<UserData>(.*)</UserData>} $xml -> userdata
        set xml_values [lmap {- value} [regexp -inline -all {<[^>]+>([^<]+)} $userdata] {
            set value
        }]
        equal_lists $values $xml_values
    } -result 1

    test evt_render_context_xpaths-1.0 {
        Render context for xpaths
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        set xpaths [list "Event/System/Provider/@Name" "Event/System/Channel"]
        set hctx [twapi::evt_render_context_xpaths $xpaths]
        set values [twapi::evt_event_render $hev $hctx]
        twapi::evt_close $hctx
        set values
    } -result {Microsoft-Windows-Servicing Setup}

    test evt_render_context_xpaths-2.0 {
        Render context for xpaths - no matches
    } -setup {
        set hev [get_event Setup]
    } -cleanup {
        twapi::evt_close $hev
    } -body {
        set xpaths [list "Event/System/NoSuch"]
        set hctx [twapi::evt_render_context_xpaths $xpaths]
        set values [twapi::evt_event_render $hev $hctx]
        twapi::evt_close $hctx
        set values
    } -result [list {}]

    test evt_render_context_xpaths-3.0 {
        Render context for xpaths - empty xpath list
    } -body {
        twapi::evt_render_context_xpaths {}
    } -result {At least one XPATH expression must be specified. TWAPI error: Invalid data.} -returnCodes error

    ### EvtSubscriber

    evttest EvtSubscriber-1.0 {
        Verify existing events ignored by default
    } {
        set osub [sess newSubscriber Application]
        set before [clock milliseconds]
        $osub waitForEvent 500
        set len1 [llength [$osub getEvents]]
        set before [clock milliseconds]
        $osub waitForEvent 500
        set after [clock milliseconds]
        set len2 [llength [$osub getEvents]]
        list $len1 $len2 [expr {($after-$before) >= 500}] 
    } -result {0 0 1}

    evttest EvtSubscriber-1.1 {
        Verify existing events returned with -includeexisting
    } {
        set osub [sess newSubscriber Application -includeexisting]
        set before [clock milliseconds]
        $osub waitForEvent 100
        set hevs [$osub getEvents -count 1]
        set after [clock milliseconds]
        twapi::evt_close {*}$hevs
        list [llength $hevs] [expr {($after-$before) < 50}]
    } -result {1 1}

    test EvtSubscriber-2.0 {
        EvtSession createSubscriber -hbookmark
    } -setup {
        twapi::EvtSession create sess
        set or [sess newReader -channel Setup]
        set hevs [$or getEvents -count 2]
        set hbm [twapi::evt_bookmark_create]
        set hev [lindex $hevs 1]
        set recid [event_record_id $hev]
        twapi::evt_bookmark_update $hbm $hev
        twapi::evt_close {*}$hevs
        set hevs {}
    } -cleanup {
        twapi::evt_close {*}$hevs $hbm
        sess destroy
    } -body {
        set osub [sess newSubscriber Setup -hbookmark $hbm]
        set before [clock milliseconds]
        $osub waitForEvent 100
        set hevs [$osub getEvents -count 1]
        set after [clock milliseconds]
        set newid [event_record_id [lindex $hevs 0]]
        list [expr {[event_record_id [lindex $hevs 0]] == 1+$recid}] [expr {($after-$before) < 50}]
    } -result {1 1}

    evttest EvtSubscriber-callback-1.0 {
        EvtSubscriber callbacks
    } {
        set result {}
        set os [sess newSubscriber Application]
        set of [sess newFormatter]
        set before [clock milliseconds]
        set lambda [list apply [list {osess osub ofmt} {
            variable gate
            while {[llength [set hevs [$osub getEvents -count 1]]]} {
                $ofmt decodeEvents $hevs -eventid
                twapi::evt_close {*}$hevs
                incr gate [llength $hevs]
            }
        } [namespace current]] sess $os $of]
        $os registerCallback $lambda
        twapi::eventlog_log "This is a message 1"
        twapi::eventlog_log "This is a message 2"
        set timer [after 1000 [list set [namespace current]::gate -1]]
        vwait [namespace current]::gate
        after cancel $timer
        lappend result $gate
        twapi::eventlog_log "This is a message 3"
        set timer [after 1000 [list set [namespace current]::gate -1]]
        vwait [namespace current]::gate
        after cancel $timer
        lappend result $gate
        twapi::eventlog_log "This is a message 4"; # should not be seen
        $os unregisterCallback
        set timer [after 1000 [list set [namespace current]::gate -1]]
        twapi::eventlog_log "This is a message 5"; # should not be seen
        vwait [namespace current]::gate
        after cancel $timer
        lappend result $gate
        set interval [expr {[clock milliseconds] - $before}]
        lappend result [expr {$interval > 1000 && $interval < 2000}]
        set result
    } -result {2 3 -1 1}

    ### evt_log, clearChannel, install, uninstall

    test evt_log-1.0 {
        evt_log - write events to Twapi-App/Operational and clear
    } -constraints \
        [list systemmodificationok [expr {[privileged] ? "privileged" : "userInteraction"}]] \
    -setup {
        if {$twapiChannel in [wevtutil_channels 1]} {
            catch {twapi::evt_twapi_uninstall; after 100}
            set twapiChannelExisted 1
        } else {
            set twapiChannelExisted 0
        }
        twapi::evt_twapi_install; after 100
        twapi::EvtSession create sess
        set result {}
    } -cleanup {
        sess destroy
    } -body {
        # May not be 0, as uninstall/install does not remove existing
        # event file.
        set precount [event_count sess -channel $twapiChannel]
        set levels {critical error warning informational verbose}
        foreach level $levels {
            twapi::evt_log $level "This is a TWAPI test $level message."
        }
        twapi::evt_log information "This is a message from TWAPI test app" -application "Twapi Test Application"
        after 1000
        set or [sess newReader -channel $twapiChannel -direction backward]
        set of [sess newFormatter]
        set result {}
        set hevs [$or getEvents -count 6]
        set hevs [lassign $hevs hev]
        set ev [$of decodeEvent $hev {-message}]
        lappend result [regexp "Application: Twapi Test Application" [dict get $ev -message]]
        try {
            foreach hev $hevs level [lreverse $levels] {
                set ev [$of decodeEvent $hev {-level -message}]
                set levelLabel [expr {$level eq "informational" ? "Information" : [string totitle $level]}]
                lappend result [expr {
                                      [string equal -nocase $levelLabel [dict get $ev -level]]
                                      &&
                                      [regexp "This is a TWAPI test $level message.\\s+Application: Tcl Application\\s+Image Path:.*[file tail [info nameofexecutable]]$" [dict get $ev -message]]
                                  }]
            }
        } finally {
            twapi::evt_close {*}$hevs
        }
        set postcount [event_count sess -channel $twapiChannel]
        lappend result [expr {$postcount-$precount}]
        if {[privileged]} {
            sess clearChannel $twapiChannel
            after 100
            lappend result [event_count sess -channel $twapiChannel]
            if {! $twapiChannelExisted} {
                twapi::evt_twapi_uninstall
                lappend result [expr {$twapiChannel in [wevtutil_channels 1]}]
                after 100
            } else {
                lappend result 0; # Don't remove channel if it already existed
            }
        } else {
            lappend result 0 0; # Ignore this piece of test
        }
        set result
    } -result {1 1 1 1 1 1 6 0 0}

    # eventlog_log

    test eventlog_log-1.0 {
        Log a message to the default log
    } -body {
        twapi::eventlog_log "TWAPI test message"
        get_last_event_message Application
    } -match glob -result  "*TWAPI test message"

    test eventlog_log-1.1 {
        Log a message to the application log
    } -constraints {
        nt
    } -body {
        twapi::eventlog_log "TWAPI Application log test message" -source application
        get_last_event_message Application
    } -match glob -result  "*TWAPI Application log test message"

    test eventlog_log-1.2 {
        Log a message to the system log
    } -constraints {
        privileged
    } -body {
        twapi::eventlog_log "TWAPI System log test message" -source system
        get_last_event_message System
    } -match glob -result  "*TWAPI System log test message"
    
    set testnum 0
    foreach source {application system} {
        foreach {type level} {success 0 error 2 warning 3 information 4} {
            test eventlog_log-2.[incr testnum] "Log a message of type $type to the $source log" -constraints [expr {$source eq "system" ? "privileged" : ""}] -body {
                twapi::eventlog_log "TWAPI log $type message" -type $type -source $source
                set hev [get_last_event $source]
                try {
                    set hctx [twapi::evt_render_context_system]
                    try {
                        set ev [twapi::evt_event_render $hev $hctx]
                        list [lindex $ev 4] [lindex $ev 14]
                    } finally {
                        twapi::evt_close $hctx
                    }
                } finally {
                    twapi::evt_close $hev
                }
            } -result [list $level [string totitle $source]]
        }
    }


    # sess clearChannel

    if {[info exists exported_setup_event_file] &&
        [file exists $exported_setup_event_file]} {
        file delete $exported_setup_event_file
    }
    if {[info exists archived_setup_event_file] &&
        [file exists $archived_setup_event_file]} {
        file delete $archived_setup_event_file
    }
    ::tcltest::cleanupTests
}
namespace delete ::twapi::evt::test

