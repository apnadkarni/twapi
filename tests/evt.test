        EvtSession with method
    } -setup {
        twapi::EvtSession create sess
    } -cleanup {
        sess destroy
    } -body {
        list [sess with {newChannelConfig Setup} publisher] \
            [info class instances ::twapi::EvtChannelConfig]
    } -result [list Microsoft-Windows-Eventlog {}]

    test EvtSession-with-2.0 {
        EvtSession with method call rasing error
    } -setup {
        twapi::EvtSession create sess
    } -cleanup {
        sess destroy
    } -body {
        list [catch {sess with {newChannelConfig Setup} publisher x y}] \
