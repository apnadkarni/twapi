    evttest EvtReader-getEvents-1.0 {Read events in default direction} {
        set or [sess newReader -channel Application]
        set of [sess newFormatter]
        lassign [$or getEvents -count 2] hev1 hev2
        try {
            array set first [$of decodeEvent $hev1 {-timecreated -eventrecordid}]
            array set second [$of decodeEvent $hev2 {-timecreated -eventrecordid}]
            expr {
              $first(-timecreated) <= $second(-timecreated) &&
              $first(-eventrecordid) < $second(-eventrecordid)
          }
        } finally {
            twapi::evt_close $hev1 $hev2
        }
    } -result 1

    evttest EvtReader-getEvents-1.1 {Read events -direction forward} {
        set or [sess newReader -channel Application -direction forward]
        set of [sess newFormatter]
        lassign [$or getEvents -count 2] hev1 hev2
        try {
            array set first [$of decodeEvent $hev1 {-timecreated -eventrecordid}]
            array set second [$of decodeEvent $hev2 {-timecreated -eventrecordid}]
            expr {
              $first(-timecreated) <= $second(-timecreated) &&
              $first(-eventrecordid) < $second(-eventrecordid)
          }
        } finally {
            twapi::evt_close $hev1 $hev2
        }
    } -result 1

