    test evt_channel_config "evt_channel_config_get" -setup {
            set hcfg [twapi::evt_channel_config_open Setup]
        } -cleanup {
            twapi::evt_close $hcfg
        } -body {
            # Test both symol and integer value
            set bad {}
            foreach {propid change} {
                -enabled         toggle
                -isolation       toggle
                -type            const
                -classic const
                -logretention    toggle
                -autobackup   toggle
                -logmaxsize      incr
                -buffersize      const
                -minbuffers      const
                -maxbuffers      const
                -latency         const
                -clocktype       const
                -sidtype         const
                -filemax         incr
            } {
                set prop [twapi::evt_channel_config_get $hcfg $propid]
                if {![string is integer -strict $prop]} {
                    lappend bad get$propid
                } else {
                    switch $change {
                        toggle { set newvalue [expr {!$prop}] }
                        incr {set newvalue [expr {$prop+1}] }
                        const {
                            # Should not permit
                            if {![catch {
                                twapi::evt_channel_config_set $hcfg $propid $prop
                            }]} {
                                lappend bad get$propid
                            }
                            continue
                        }
                    }
                    # Note this only changes in-memory cache and does not
                    # require privs
                    twapi::evt_channel_config_set $hcfg $propid $newvalue
                    if {[twapi::evt_channel_config_get $hcfg $propid] != $newvalue} {
                        lappend bad set$propid; # The set failed
                    }
                }
            }
            if {![string equal -nocase Setup.evtx [file tail [twapi::evt_channel_config_get $hcfg -logfilepath]]]} {
                lappend bad get-logfilepath
            }
            if {![string equal -nocase Microsoft-Windows-Eventlog [file tail [twapi::evt_channel_config_get $hcfg -publisher]]]} {
                lappend bad get-publisher
            }
            if {[catch {twapi::sddl_to_security_descriptor [twapi::evt_channel_config_get $hcfg -access]}]} {
                lappend bad get-access
            }
            foreach propid {
                -level         10
                -keywords      11
                -controlguid   12
            } {
                # Value could be anything. Just ensure no error
                if {[catch {twapi::evt_channel_config_get $hcfg $propid}]} {
                    lappend bad get$propid
                }
            }
            if {"Microsoft-Windows-Eventlog" ni [twapi::evt_channel_config_get $hcfg -publisherlist]} {
                lappend bad get-publisherlist
            }
            set bad
        } -result {}

