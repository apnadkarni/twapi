    test evt_render_context_system-1.0 {
        Render context for system properties
    } -setup {
        set hquery [twapi::evt_query -channel Setup]
        set hevents [twapi::evt_next $hquery]
    } -cleanup {
        twapi::evt_close {*}$hevents $hquery
    } -body {
        set hctx [twapi::evt_render_context_system]
        set hevt [lindex $hevents 0]
        set xml [twapi::evt_event_xml $hevt]
        regexp {Provider Name='([^']+)'\s+Guid='([^']+)'.+ProcessID='([^']+)'} $xml -> provider guid pid
        set values [twapi::evt_event_render $hevt $hctx]
        twapi::evt_close $hctx
        list [llength $values] \
            [expr {$provider eq [lindex $values 0]}] \
            [string equal -nocase $guid [lindex $values 1]] \
            [expr {$pid eq [lindex $values 12]}] \
            [lindex $values 14]
    } -result [list [llength [twapi::evt_system_properties]] 1 1 1 Setup]

