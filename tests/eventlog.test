    test evt_publisher_property-1.0 {
        Get publisher metadata
    } -setup {
        set hpub [twapi::evt_publisher_open Microsoft-Windows-Eventlog -lcid 1033]
    } -cleanup {
        twapi::evt_close $hpub
    } -body {
        set bad {}
        foreach {prop pat} {
            -guid {{FC65DDD8-D6EF-4962-83D5-6E5CFE9CE148}}
            -resourcefile *System32\\\\wevtsvc.dll
            -parameterfile *
            -messagefile *System32\\\\wevtsvc.dll
            -helplink https://go.microsoft.com/*
        } {
            set val [twapi::evt_publisher_property $hpub $prop]
            if {![string match -nocase $pat $val]} {
                lappend bad $prop
            }
        }
        set val [twapi::evt_publisher_property $hpub -messageid]
        if {! [string equal -nocase \
                   [twapi::evt_publisher_message $hpub $val] \
                   Microsoft-Windows-Eventlog]} {
            lappend prop -messageid
        }
        set chanrefs [twapi::evt_publisher_property $hpub -channels]
        foreach chanref $chanrefs {
            foreach key {-channelindex -channelid -channelflags} {
                if {![dict exists $chanref $key] || \
                        ![string is integer -strict [dict get $chanref $key]]} {
                    lappend bad -channels($key)
                }
            }
            # File tail because the message string for Microsoft-Windows-EventLog/Debug
            # etc is just Debug
            if {![string equal -nocase \
                      [twapi::evt_publisher_message $hpub \
                           [dict get $chanref -channelmessageid]] \
                      [file tail [dict get $chanref -channelpath]]]} {
                lappend bad -channels([dict get $chanref -channelpath])
                break
            }
        }
        set levels [twapi::evt_publisher_property $hpub -levels]
        foreach level $levels {
            if {![regexp {^win:(.+)} [dict get $level -levelname] -> level_name]} {
                lappend bad -levels([dict get $level -levelname])
                continue
            }
            set level_label \
                [expr {
                       $level_name eq "Informational" ? "Information" : $level_name
                   }]
            if {![string equal -nocase \
                      [twapi::evt_publisher_message $hpub \
                           [dict get $level -levelmessageid]] \
                      $level_label]} {
                lappend bad -levels($level_name)
                continue
            }
            if {[dict get $level -levelvalue] != [dict get {
                Critical 1 Error 2 Warning 3 Informational 4 Verbose 5
            } $level_name]} {
                lappend bad -levels($level_name)
                continue
            }
        }
        set tasks [twapi::evt_publisher_property $hpub -tasks]
        foreach task $tasks {
            if {![regexp {^el:(.+)} [dict get $task -taskname] -> task_name]} {
                lappend bad -tasks([dict get $task -taskname])
                continue
            }
            set task_label [dict get {
                Initialization "Service startup"
                EventProcessing "Event processing"
                Shutdown "Service shutdown"
                LogClear "Log clear"
                AutoBackup "Log automatic backup"
                AbnormalShutdown "System abnormal shutdown"
                UsageAudit "Service Usage Audit"
            } $task_name]
            if {![string equal -nocase \
                      [twapi::evt_publisher_message $hpub \
                           [dict get $task -taskmessageid]] \
                      $task_label]} {
                lappend bad -tasks($task_name,-taskmessageid)
                continue
            }
            if {![string is integer -strict [dict get $task -taskvalue]]} {
                lappend bad -tasks($task_name,-taskvalue)
                continue
            }
            if {![valid_guid [dict get $task -taskeventguid]]} {
                lappend bad -tasks($task_name,-taskguid)
            }
        }

        set opcodes [twapi::evt_publisher_property $hpub -opcodes]
        foreach opcode $opcodes {
            if {![regexp {^win:(.+)} [dict get $opcode -opcodename] -> opcode_name]} {
                lappend bad -opcodes([dict get $opcode -opcodename])
                continue
            }
            if {![string equal -nocase \
                      [twapi::evt_publisher_message $hpub \
                           [dict get $opcode -opcodemessageid]] \
                      $opcode_name]} {
                lappend bad -opcodes($opcode_name,-opcodemessageid)
                continue
            }
            if {![string is integer -strict [dict get $opcode -opcodevalue]]} {
                lappend bad -opcodes($opcode_name,-opcodevalue)
                continue
            }
        }
        set keywords [twapi::evt_publisher_property $hpub -keywords]
        foreach keyword $keywords {
            if {![regexp {^[^:]+:(.+)} [dict get $keyword -keywordname] -> keyword_name]} {
                lappend bad -keywords([dict get $keyword -keywordname])
                continue
            }
            set keyword_label [dict get {
                Availability "Service availability"
                Settings "Service configuration"
                SystemAvailability "System availability"
                Audit "API Usage Audit"
                AuditSuccess "Audit Success"
            } $keyword_name]
            if {![string equal -nocase \
                      [twapi::evt_publisher_message $hpub \
                           [dict get $keyword -keywordmessageid]] \
                      $keyword_label]} {
                lappend bad -keywords($keyword_name,-keywordmessageid)
                continue
            }
            if {![string is integer -strict [dict get $keyword -keywordvalue]]} {
                lappend bad -keywords($keyword_name,-keywordvalue)
                continue
            }
        }

        set bad
    } -result {}

    ################################################################

    test evt_publisher_events-1.0 {
        Get publisher events
    } -setup {
        set hpub [twapi::evt_publisher_open Microsoft-Windows-Setup]
    } -cleanup {
        twapi::evt_close $hpub
    } -body {
        set bad {}
        set events_metadata [twapi::evt_publisher_events $hpub {
            -id -channel -version -level -opcode -task -keyword -messageid -template
        }]
        foreach event_metadata $events_metadata {
            foreach key {
                -id -channel -version -level -opcode -task -keyword -messageid
            } {
                if {![dict exists $event_metadata $key] ||
                    ![string is integer -strict [dict get $event_metadata $key]]
                } {
                    lappend bad $key
                }
                set messageid [dict get $event_metadata -messageid]
                if {$messageid != -1} {
                    if {[twapi::evt_publisher_message $hpub $messageid] eq ""} {
                        lappend bad -messageid($messageid)
                    }
                }
                set template [dict get $event_metadata -template]
                if {$template ne "" &&
                    ![regexp {^<template.*</template>\s*$} $template]} {
                    lappend bad -template([dict get $event_metadata -id])
                }
            }
        }
        set bad
    } -result {}

    ################################################################

    test winlog_backup-1.0 {
        Back up the eventlog, also covers winlog_event_count-2.0
    } -body {
        set backup [file join $::env(TEMP) twapi_winlog_test.bak]
        twapi::winlog_backup Application $backup
        set count [twapi::winlog_event_count -channel Application]
        set count2 [twapi::winlog_event_count -file $backup]
        expr {$count == $count2}
    } -cleanup {
        file delete $backup
    } -result 1

    ################################################################

    test winlog_close-1.0 {
        Close a event log handle
    } -body {
        set hevl [twapi::winlog_open]
        twapi::winlog_close $hevl
        # Should generate error when closing
        catch {twapi::winlog_close $hevl}
    } -result 1

    ################################################################

    test winlog_event_count-1.0 {
        winlog_event_count -channel
    } -body {
        twapi::eventlog_log "TWAPI test winlog_event_count-1.0 [clock seconds]" -source Application
        set count [twapi::winlog_event_count -channel Application]
        expr {$count > 0}
    } -result 1

    test winlog_event_count-2.0 {
        winlog_event_count -file
    } -constraints {
        coveredelsewhere
    } -body {
        Covered by winlog_backup-1.0
    } -result ""

    test winlog_event_count-3.0 {
        winlog_event_count -system
    } -body {
        set count1 [twapi::winlog_event_count -channel Application -system $::env(COMPUTERNAME)]
        twapi::eventlog_log "TWAPI test winlog_event_count-1.0" -source Application -system $::env(COMPUTERNAME)
        set count2 [twapi::winlog_event_count -channel Application -system $::env(COMPUTERNAME)]
        expr {$count2 == ($count1 + 1)}
    } -result 1

    test winlog_event_count-3.1 {
        winlog_event_count -system (fail) - make sure -system option is actually seen
    } -body {
        list [catch {twapi::winlog_event_count -channel Application -system NOSUCHSYSTEM}] [errorcode]
    } -result {1 {TWAPI_WIN32 1722}}

    ################################################################

    test winlog_open-1.0 {
        winlog_open
    } -constraints {
        coveredelsewhere
    } -body {
        Convered by winlog_read
    } -result ""

    ################################################################

    set testnum -1
    foreach source {application system security} {
        test winlog_read-1.[incr testnum] "winlog_read event log records from the $source log" -body {
            patience "Reading events"
            set hevl [twapi::winlog_open -channel $source]
            set msgs ""
            set count 0
            while {[twapi::recordarray size [set events [twapi::winlog_read $hevl]]]} {
                foreach eventrec [twapi::recordarray getlist $events -format dict] {
                    incr count
                    set msgs [verify_winlog_event $eventrec]
                    if {[llength $msgs]} break
                }
                if {[llength $msgs]} break
            }
            twapi::winlog_close $hevl
            list [expr {$count > 0}] [llength $msgs]
        } -result {1 0}
    }

    test winlog_read-2.0 {
        Verify winlog is read in forward direction by default
    } -body {
        set hevl [twapi::winlog_open]
        set recs [twapi::winlog_read $hevl]
        if {[twapi::recordarray size $recs] < 5} {
            set recs [twapi::recordarray concat $recs [twapi::winlog_read $hevl]]
        }
        set ok 1
        set rec_id 0
        foreach rec [twapi::recordarray getlist $recs -format dict] {
            set rec_next [dict get $rec -eventrecordid]
            if {$rec_next <= $rec_id} {
                set ok 0
                break
            }
            set rec_id $rec_next
        }
        twapi::winlog_close $hevl
        set ok
    } -result 1

    test winlog_read-2.1 {
        Verify winlog_read forward
    } -body {
        set hevl [twapi::winlog_open -direction forward]
        set recs [twapi::winlog_read $hevl]
        if {[twapi::recordarray size $recs] < 5} {
            set recs [twapi::recordarray concat $recs [twapi::winlog_read $hevl]]
        }
        set ok 1
        set rec_id 0
        foreach rec [twapi::recordarray getlist $recs -format dict] {
            set rec_next [dict get $rec -eventrecordid]
            if {$rec_next <= $rec_id} {
                set ok 0
                break
            }
            set rec_id $rec_next
        }
        twapi::winlog_close $hevl
        set ok
    } -result 1

    test winlog_read-2.2 {
        Verify winlog_read backward
    } -body {
        set hevl [twapi::winlog_open -direction backward]
        set recs [twapi::winlog_read $hevl]
        if {[twapi::recordarray size $recs] < 5} {
            set recs [twapi::recordarray concat $recs [twapi::winlog_read $hevl]]
        }
        set ok 1
        set rec_id 0x7fffffff
        foreach rec [twapi::recordarray getlist $recs -format dict] {
            set rec_next [dict get $rec -eventrecordid]
            if {$rec_next >= $rec_id} {
                set ok 0
                break
            }
            set rec_id $rec_next
        }
        twapi::winlog_close $hevl
        set ok
    } -result 1


    test winlog_read-3.0 {
        Verify winlog read with -system 
    } -body {
        set hevl [twapi::winlog_open -system $::env(COMPUTERNAME)]
        set recs [twapi::winlog_read $hevl]
        foreach eventrec [twapi::recordarray getlist $recs -format dict] {
            set msgs [verify_winlog_event $eventrec]
            if {[llength $msgs]} break
        }
        twapi::winlog_close $hevl
        set msgs
    } -result ""

    test winlog_read-3.1 {
        Verify winlog read with -system (fail - to verify -system option is obeyed)
    } -body {
        list [catch {twapi::winlog_open -system NOSUCHSYSTEM}] [errorcode]
    } -result {1 {TWAPI_WIN32 1722}}


    test winlog_read-4.0 {
        winlog_read event log records from file
    } -setup {
        set backup [file join $::env(TEMP) winlog_read_file.bak]
        twapi::winlog_backup Application $backup
    } -body {
        patience "Reading events"
        set hevl [twapi::winlog_open -file $backup]
        set msgs ""
        set count 0
        while {[twapi::recordarray size [set events [twapi::winlog_read $hevl]]]} {
            foreach eventrec [twapi::recordarray getlist $events -format dict] {
                incr count
                set msgs [verify_winlog_event $eventrec]
                if {[llength $msgs]} break
            }
            if {[llength $msgs]} break
        }
        twapi::winlog_close $hevl
        list [expr {$count > 0}] [llength $msgs]
    } -cleanup {
        file delete $backup
    } -result {1 0}



    test winlog_read-100.0 {
        winlog_read -lcid
    } -constraints {
        TBD
    } -body {} -result {}

    ################################################################

    #NOTE - KEEP THESE WINLOG CLEAR TESTS AT THE END AFTER ANY READ TESTS

    test winlog_clear-1.0 {
        Clear the event log
    } -constraints {
        systemmodificationok
    } -setup {
        # Make sure there are events in the log
        twapi::eventlog_log "TWAPI Test winlog_clear-1.0" -source Application
        if {[twapi::winlog_event_count -channel Application] == 0} {
            error "No events in event log"
        }
    } -body {
        twapi::winlog_clear Application
        twapi::winlog_event_count -channel Application
    } -result 0

    test winlog_clear-1.1 {
        Backup and clear the event log
    } -constraints {
        systemmodificationok
    } -setup {
        # Make sure there are events in the log
        twapi::eventlog_log "TWAPI Test winlog_clear-1.1" -source Application
        if {[twapi::winlog_event_count -channel Application] == 0} {
            error "No events in event log"
        }
    } -body {
        set backup [file join $::env(TEMP) twapi_events_clear_test_[clock microseconds].bak]
        set count1 [twapi::winlog_event_count -channel Application]
        twapi::winlog_clear Application -backup $backup
        set count2 [twapi::winlog_event_count -channel Application]
        set count3 [twapi::winlog_event_count -file $backup]
        list [expr {$count1 == $count3}] $count2
    } -result {1 0}

    ################################################################

    test winlog_subscribe-1.0 {
        Verify asynchronous monitoring of event log
    } -setup {
        patience winlog_subscribe-1.0
        # Note this test may sometimes fail because event log service
        # restricts frequency of notifications to 5 sec intervals
        # For this reason, we also test start and stop in a single test
        after 6000
    } -body {
        lassign [twapi::winlog_subscribe Application] hevl hevent
        # The read has to fail before events are sent. So read all
        # events first
        while {[twapi::recordarray size [twapi::winlog_read $hevl]]} {}
        # Write a message
        twapi::eventlog_log "winlog_subscribe test message"
        twapi::wait_on_handle $hevent -wait 6000

        # NOTE - on XP / 2k3 THIS WILL LIKELY FAIL BECAUSE IT USES
        # PULSE EVENT WHICH REQUIRES A SEPARATE THREAD TO BE WAITING
        # WHICH IS WHAT eventlog_monitor does

    } -cleanup {
        twapi::winlog_close $hevl
    } -result signalled

    ################################################################

    #
    # Clean up
    if {[info exists exported_setup_event_file] &&
        [file exists $exported_setup_event_file]} {
        file delete $exported_setup_event_file
    }

    ::tcltest::cleanupTests
}

namespace delete ::twapi::eventlog::test
