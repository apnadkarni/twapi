    test evt-bookmarks-1.0 {
        evt_bookmark_create, evt_bookmark_update, evt_seek -bookmark
    } -setup {
        set hquery [twapi::evt_query -channel Setup]
        set hevents [twapi::evt_next $hquery -count 2]
        set hevent [lindex $hevents 1]
        set event_xml [twapi::evt_event_xml $hevent]
    } -cleanup {
        twapi::evt_close {*}$hevents $hbook $hquery
    } -body {
        set hbook [twapi::evt_bookmark_create]
        twapi::evt_bookmark_update $hbook $hevent
        twapi::evt_close {*}$hevents
        set hevents [twapi::evt_next $hquery -count 2]
        set new_xml [twapi::evt_event_xml [lindex $hevents 0]]
        twapi::evt_close {*}$hevents
        twapi::evt_seek $hquery 0 -bookmark $hbook
        set hevents [twapi::evt_next $hquery -count 2]
        set event_xml_bookmarked [twapi::evt_event_xml [lindex $hevents 0]]
        list [string equal $event_xml $new_xml] \
            [string equal $event_xml $event_xml_bookmarked]
    } -result {0 1}

